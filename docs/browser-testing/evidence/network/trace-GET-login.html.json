{"method":"GET","url":"http://localhost:9090/jnosql-admin/login.html","requestBody":null,"statusCode":200,"responseHeaders":{"Status-Line":["HTTP/1.1 200 OK"],"Access-control-allow-headers":["Content-Type, X-API-Key, Authorization, Cookie, X-CSRF-Token"],"X-frame-options":["DENY"],"Referrer-policy":["strict-origin-when-cross-origin"],"Date":["Mon, 21 Sep 2026 05:52:46 GMT"],"Content-security-policy":["default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"],"Access-control-allow-methods":["GET, POST, PUT, DELETE, OPTIONS"],"Content-type":["text/html"],"Access-control-allow-origin":["*"],"Access-control-allow-credentials":["true"],"Content-length":["10634"],"X-content-type-options":["nosniff"],"X-xss-protection":["1; mode=block"]},"responseBody":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>JunifyDB — Sign In</title>\r\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\r\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\r\n    <link rel=\"stylesheet\" href=\"/css/enhancements.css\">\r\n    <style>\r\n        :root {\r\n            --bg-base: #090914;\r\n            --bg-card: rgba(18, 20, 38, 0.85);\r\n            --border-card: rgba(255, 255, 255, 0.08);\r\n            --accent-grad: linear-gradient(135deg, #6366f1, #a855f7);\r\n            --accent-glow: rgba(99, 102, 241, 0.25);\r\n            --text-main: #f8fafc;\r\n            --text-sub: #94a3b8;\r\n        }\r\n        body {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            min-height: 100vh;\r\n            background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.12) 0%, transparent 60%), #090914;\r\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\r\n            color: var(--text-main);\r\n            margin: 0;\r\n            padding: 24px;\r\n            box-sizing: border-box;\r\n        }\r\n        .login-card {\r\n            background: var(--bg-card);\r\n            backdrop-filter: blur(16px);\r\n            -webkit-backdrop-filter: blur(16px);\r\n            border: 1px solid var(--border-card);\r\n            border-radius: 16px;\r\n            width: 100%;\r\n            max-width: 420px;\r\n            padding: 36px 32px;\r\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);\r\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n        }\r\n        .login-header {\r\n            text-align: center;\r\n            margin-bottom: 28px;\r\n        }\r\n        .login-logo-wrap {\r\n            display: inline-flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            margin-bottom: 14px;\r\n            border-radius: 18px;\r\n            box-shadow: 0 8px 24px var(--accent-glow);\r\n        }\r\n        .login-title {\r\n            font-size: 1.6rem;\r\n            font-weight: 700;\r\n            letter-spacing: -0.02em;\r\n            color: #ffffff;\r\n            margin: 0 0 6px 0;\r\n        }\r\n        .login-subtitle {\r\n            font-size: 0.85rem;\r\n            color: var(--text-sub);\r\n            margin: 0;\r\n        }\r\n        .login-badge {\r\n            display: inline-block;\r\n            margin-top: 8px;\r\n            padding: 3px 10px;\r\n            border-radius: 50px;\r\n            font-size: 0.72rem;\r\n            font-weight: 600;\r\n            background: rgba(99, 102, 241, 0.15);\r\n            color: #a5b4fc;\r\n            border: 1px solid rgba(99, 102, 241, 0.3);\r\n        }\r\n        .form-group {\r\n            margin-bottom: 18px;\r\n        }\r\n        .form-label {\r\n            display: block;\r\n            font-size: 0.82rem;\r\n            font-weight: 600;\r\n            color: #cbd5e1;\r\n            margin-bottom: 6px;\r\n        }\r\n        .form-input {\r\n            width: 100%;\r\n            padding: 11px 14px;\r\n            background-color: rgba(10, 12, 24, 0.75);\r\n            border: 1px solid rgba(255, 255, 255, 0.12);\r\n            border-radius: 8px;\r\n            color: #ffffff;\r\n            font-size: 0.88rem;\r\n            box-sizing: border-box;\r\n            transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;\r\n        }\r\n        .form-input:focus {\r\n            outline: none;\r\n            background-color: rgba(15, 18, 35, 0.95);\r\n            border-color: #6366f1;\r\n            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);\r\n        }\r\n        .form-input::placeholder {\r\n            color: #64748b;\r\n        }\r\n        .btn-submit {\r\n            width: 100%;\r\n            padding: 12px 18px;\r\n            background: var(--accent-grad);\r\n            color: #ffffff;\r\n            border: none;\r\n            border-radius: 8px;\r\n            font-size: 0.9rem;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;\r\n            margin-top: 10px;\r\n            box-shadow: 0 4px 16px var(--accent-glow);\r\n        }\r\n        .btn-submit:hover:not(:disabled) {\r\n            opacity: 0.94;\r\n            transform: translateY(-1px);\r\n            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);\r\n        }\r\n        .btn-submit:disabled {\r\n            opacity: 0.6;\r\n            cursor: not-allowed;\r\n        }\r\n        .error-message {\r\n            display: none;\r\n            background-color: rgba(239, 68, 68, 0.15);\r\n            border: 1px solid rgba(239, 68, 68, 0.4);\r\n            color: #fca5a5;\r\n            padding: 11px 14px;\r\n            border-radius: 8px;\r\n            font-size: 0.84rem;\r\n            margin-bottom: 18px;\r\n            line-height: 1.4;\r\n        }\r\n        .login-footer {\r\n            margin-top: 28px;\r\n            text-align: center;\r\n            font-size: 0.75rem;\r\n            color: #64748b;\r\n            border-top: 1px solid rgba(255, 255, 255, 0.06);\r\n            padding-top: 16px;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"login-card\">\r\n        <div class=\"login-header\">\r\n            <div class=\"login-logo-wrap\">\r\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 400\" width=\"54\" height=\"54\">\r\n                    <defs>\r\n                        <linearGradient id=\"lgLogin\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#6366f1\"/><stop offset=\"1\" stop-color=\"#a855f7\"/></linearGradient>\r\n                    </defs>\r\n                    <rect x=\"50\" y=\"50\" width=\"300\" height=\"300\" rx=\"60\" fill=\"url(#lgLogin)\"/>\r\n                    <g transform=\"translate(100,100)\">\r\n                        <ellipse cx=\"100\" cy=\"30\" rx=\"70\" ry=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.9\"/>\r\n                        <path d=\"M30 30 L30 170 Q30 190 100 190 Q170 190 170 170 L170 30\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.8\"/>\r\n                        <ellipse cx=\"100\" cy=\"100\" rx=\"70\" ry=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.6\"/>\r\n                        <ellipse cx=\"100\" cy=\"170\" rx=\"70\" ry=\"20\" fill=\"none\" stroke=\"#fff\" stroke-width=\"8\" opacity=\"0.4\"/>\r\n                    </g>\r\n                </svg>\r\n            </div>\r\n            <h1 class=\"login-title\">JunifyDB Console</h1>\r\n            <p class=\"login-subtitle\">Sign in to manage your embedded database</p>\r\n            <span class=\"login-badge\">Dual-Engine &bull; NoSQL + ANSI SQL</span>\r\n        </div>\r\n\r\n        <div id=\"errorMessage\" class=\"error-message\" role=\"alert\"></div>\r\n\r\n        <form id=\"loginForm\" onsubmit=\"handleLogin(event)\">\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"username\">Username</label>\r\n                <input class=\"form-input\" type=\"text\" id=\"username\" name=\"username\" value=\"admin\" autocomplete=\"username\" placeholder=\"e.g. admin\">\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"password\">Password</label>\r\n                <input class=\"form-input\" type=\"password\" id=\"password\" name=\"password\" autocomplete=\"current-password\" placeholder=\"••••••••\">\r\n            </div>\r\n\r\n            <div class=\"form-group\">\r\n                <label class=\"form-label\" for=\"apiKey\">API Key (Optional)</label>\r\n                <input class=\"form-input\" type=\"password\" id=\"apiKey\" name=\"apiKey\" placeholder=\"Leave blank if disabled\">\r\n            </div>\r\n\r\n            <button type=\"submit\" class=\"btn-submit\" id=\"submitBtn\">Sign In</button>\r\n        </form>\r\n\r\n        <div class=\"login-footer\">\r\n            JunifyDB Embedded Multi-Model Database &bull; Secure Console\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        const getBasePath = () => {\r\n            let p = window.location.pathname;\r\n            if (p.endsWith('.html')) p = p.substring(0, p.lastIndexOf('/'));\r\n            while (p.endsWith('/')) p = p.slice(0, -1);\r\n            return p;\r\n        };\r\n        const BASE_PATH = getBasePath();\r\n        const API_LOGIN = BASE_PATH ? (BASE_PATH + '/api/auth/login') : '/api/auth/login';\r\n\r\n        async function handleLogin(e) {\r\n            e.preventDefault();\r\n            const submitBtn = document.getElementById('submitBtn');\r\n            const errorEl = document.getElementById('errorMessage');\r\n            const username = document.getElementById('username').value.trim();\r\n            const password = document.getElementById('password').value;\r\n            const apiKey = document.getElementById('apiKey').value.trim();\r\n\r\n            errorEl.style.display = 'none';\r\n            submitBtn.disabled = true;\r\n            submitBtn.textContent = 'Signing in...';\r\n\r\n            try {\r\n                const res = await fetch(API_LOGIN, {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({ username, password, apiKey })\r\n                });\r\n\r\n                if (res.ok) {\r\n                    const data = await res.json().catch(() => ({}));\r\n                    const headerCsrf = res.headers.get('X-CSRF-Token');\r\n                    const csrf = data.csrfToken || headerCsrf;\r\n                    if (csrf) {\r\n                        sessionStorage.setItem('csrfToken', csrf);\r\n                    }\r\n                    if (data.session) {\r\n                        sessionStorage.setItem('session', data.session);\r\n                    }\r\n                    if (apiKey) {\r\n                        localStorage.setItem('apiKey', apiKey);\r\n                    }\r\n                    window.location.href = BASE_PATH ? (BASE_PATH + '/index.html') : 'index.html';\r\n                } else {\r\n                    const err = await res.json().catch(() => ({ message: 'Sign in failed' }));\r\n                    errorEl.textContent = err.message || 'Invalid credentials or API key';\r\n                    errorEl.style.display = 'block';\r\n                }\r\n            } catch (err) {\r\n                // If auth is not enabled on server, direct redirect\r\n                if (apiKey) localStorage.setItem('apiKey', apiKey);\r\n                window.location.href = BASE_PATH ? (BASE_PATH + '/index.html') : 'index.html';\r\n            } finally {\r\n                submitBtn.disabled = false;\r\n                submitBtn.textContent = 'Sign In';\r\n            }\r\n        }\r\n    </script>\r\n</body>\r\n</html>\r\n"}